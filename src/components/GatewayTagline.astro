---
/**
 * GatewayTagline — fill-in-the-blank cycling hero for Prototype C home.
 * Brand + campus row; large characteristic phrase with optional location footnote.
 */
import { siteLink } from '../lib/content';
import type { Characteristic } from '../lib/content';

interface Props {
  brand: string;
  characteristics: Characteristic[];
  campuses?: { name: string; slug: string }[];
}

const { brand, characteristics, campuses = [] } = Astro.props;
const aboutPath = siteLink('/what-were-about');
const items = characteristics.map((c) => ({
  ...c,
  href: `${aboutPath}#${c.aboutAnchor}`,
}));
const itemsJson = JSON.stringify(items);
const initialFootnote = items[0].footnote ?? '';
---

<div class="gateway-tagline" data-gateway-tagline>
  <p class="gateway-tagline__brand-row">
    <span class="gateway-tagline__brand">{brand}</span>
    {campuses.length > 0 && (
      <span class="gateway-tagline__campuses" aria-label="Triangle campuses">
        {campuses.map((campus, index) => (
          <>
            {index > 0 && <span class="gateway-tagline__campus-sep" aria-hidden="true">·</span>}
            <span class="gateway-tagline__campus" data-campus={campus.slug}>{campus.name}</span>
          </>
        ))}
      </span>
    )}
  </p>

  <h1 class="gateway-tagline__cycle" aria-live="polite">
    <span class="gateway-tagline__phrase-wrap">
      <a
        class="gateway-tagline__phrase"
        id="gateway-tagline-link"
        href={items[0].href}
      >
        <span id="gateway-tagline-text">{items[0].phrase}</span>
      </a><button
        type="button"
        class="gateway-tagline__footnote"
        id="gateway-tagline-footnote"
        aria-label="Location details"
        aria-expanded="false"
        aria-controls="gateway-tagline-tip"
        hidden={!initialFootnote}
      >*</button>
      <span
        id="gateway-tagline-tip"
        class="gateway-tagline__tip"
        role="tooltip"
        hidden
      >
        {initialFootnote}
      </span>
    </span>
  </h1>
</div>

<script define:vars={{ itemsJson }}>
  const root = document.querySelector('[data-gateway-tagline]');
  const link = document.getElementById('gateway-tagline-link');
  const phraseText = document.getElementById('gateway-tagline-text');
  const footnoteBtn = document.getElementById('gateway-tagline-footnote');
  const footnoteTip = document.getElementById('gateway-tagline-tip');
  if (!root || !link || !phraseText || !footnoteBtn || !footnoteTip) {
    throw new Error('GatewayTagline elements missing');
  }

  const items = JSON.parse(itemsJson);
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let index = 0;
  let timer = null;
  let paused = false;

  function setFootnoteOpen(open) {
    footnoteBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) {
      footnoteTip.removeAttribute('hidden');
    } else {
      footnoteTip.setAttribute('hidden', '');
    }
  }

  function isFootnoteOpen() {
    return footnoteBtn.getAttribute('aria-expanded') === 'true';
  }

  function updateFootnote(item) {
    setFootnoteOpen(false);
    if (item.footnote) {
      footnoteTip.textContent = item.footnote;
      footnoteBtn.removeAttribute('hidden');
    } else {
      footnoteBtn.setAttribute('hidden', '');
      footnoteTip.textContent = '';
    }
  }

  function showItem(i) {
    const item = items[i];
    link.href = item.href;
    phraseText.textContent = item.phrase;
    updateFootnote(item);
    link.classList.remove('is-fading');
    footnoteBtn.classList.remove('is-fading');
    void link.offsetWidth;
    link.classList.add('is-entering');
    if (!footnoteBtn.hasAttribute('hidden')) footnoteBtn.classList.add('is-entering');
    window.setTimeout(() => {
      link.classList.remove('is-entering');
      footnoteBtn.classList.remove('is-entering');
    }, 300);
  }

  function scheduleNext() {
    if (reducedMotion || paused || items.length < 2) return;
    clearTimeout(timer);
    const hold = items[index].holdMs ?? 4000;
    timer = window.setTimeout(() => {
      link.classList.add('is-fading');
      if (!footnoteBtn.hasAttribute('hidden')) footnoteBtn.classList.add('is-fading');
      window.setTimeout(() => {
        index = (index + 1) % items.length;
        showItem(index);
        scheduleNext();
      }, 280);
    }, hold);
  }

  footnoteBtn.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();
    setFootnoteOpen(!isFootnoteOpen());
  });

  document.addEventListener('click', (event) => {
    if (!isFootnoteOpen()) return;
    const target = event.target;
    if (target instanceof Node && !root.contains(target)) setFootnoteOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isFootnoteOpen()) {
      setFootnoteOpen(false);
      footnoteBtn.focus();
    }
  });

  root.addEventListener('mouseenter', () => { paused = true; clearTimeout(timer); });
  root.addEventListener('mouseleave', () => { paused = false; scheduleNext(); });
  root.addEventListener('focusin', () => { paused = true; clearTimeout(timer); });
  root.addEventListener('focusout', () => { paused = false; scheduleNext(); });

  if (!reducedMotion && items.length > 1) scheduleNext();
</script>

<style>
  .gateway-tagline {
    margin: 0;
  }
  .gateway-tagline__brand-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.5rem;
    margin: 0 0 0.35rem;
  }
  .gateway-tagline__brand {
    font-size: clamp(1.125rem, 4vw, 1.5rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--muted, #64748b);
    letter-spacing: 0.01em;
  }
  .gateway-tagline__campuses {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    font-size: clamp(0.6875rem, 2.2vw, 0.8125rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted, #64748b);
  }
  .gateway-tagline__campus-sep {
    opacity: 0.55;
  }
  .gateway-tagline__campus[data-campus="duke"] { color: #003087; }
  .gateway-tagline__campus[data-campus="nc-state"] { color: #cc0000; }
  .gateway-tagline__campus[data-campus="unc"] { color: #4b9cd3; }
  .site--dark .gateway-tagline__campus[data-campus="duke"] { color: #5b8fd9; }
  .site--dark .gateway-tagline__campus[data-campus="nc-state"] { color: #ff6666; }
  .site--dark .gateway-tagline__campus[data-campus="unc"] { color: #7bafd4; }
  .gateway-tagline__cycle {
    position: relative;
    margin: 0;
    min-height: 2.4em;
    font-size: clamp(1.5rem, 6.5vw, 2.125rem);
    font-weight: 700;
    line-height: 1.2;
  }
  .gateway-tagline__phrase-wrap {
    display: inline;
    position: relative;
  }
  .gateway-tagline__phrase {
    color: var(--text, #0f172a);
    text-decoration: none;
    transition: opacity 0.28s ease, text-decoration-color 0.2s ease;
    display: inline;
  }
  .gateway-tagline__phrase:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 2px;
  }
  .gateway-tagline__phrase:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  .gateway-tagline__phrase.is-fading { opacity: 0; }
  .gateway-tagline__phrase.is-entering { opacity: 1; }
  .gateway-tagline__footnote.is-fading { opacity: 0; }
  .gateway-tagline__footnote.is-entering { opacity: 1; }
  .gateway-tagline__footnote {
    display: inline;
    vertical-align: super;
    margin: 0;
    padding: 0.5rem 0.25rem 0.125rem;
    border: none;
    background: transparent;
    color: #dc2626;
    font-size: 0.62em;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.28s ease, color 0.2s ease;
  }
  .gateway-tagline__footnote:hover,
  .gateway-tagline__footnote[aria-expanded="true"] {
    color: #b91c1c;
  }
  .site--dark .gateway-tagline__footnote {
    color: #f87171;
  }
  .site--dark .gateway-tagline__footnote:hover,
  .site--dark .gateway-tagline__footnote[aria-expanded="true"] {
    color: #fca5a5;
  }
  .gateway-tagline__footnote:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 4px;
  }
  .gateway-tagline__footnote:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 4px;
  }
  .gateway-tagline__footnote[hidden] { display: none; }
  .gateway-tagline__tip {
    position: absolute;
    left: 0;
    top: calc(100% + 0.5rem);
    z-index: 20;
    max-width: min(20rem, 90vw);
    padding: 0.625rem 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--border, #e2e8f0);
    background: var(--phone-screen, #fff);
    color: var(--text, #0f172a);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.45;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
  }
  .site--dark .gateway-tagline__tip {
    background: #111;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }
  .gateway-tagline__tip[hidden] { display: none; }
</style>
