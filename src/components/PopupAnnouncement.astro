---
/**
 * PopupAnnouncement — modal overlay for urgent news.
 * Driven by src/data/announcements.yaml (popup.enabled).
 * Dismiss state stored in localStorage per message hash.
 * Listens for openMakenewPopup event (from top bar triggerPopup).
 */
import type { Announcements } from '../lib/content';
import { siteLink } from '../lib/content';

interface Props {
  announcements: Announcements;
  variant?: 'dark' | 'light';
}

const { announcements, variant = 'dark' } = Astro.props;
const popup = announcements.popup;
const popupId = popup.message.slice(0, 40).replace(/\s+/g, '-').toLowerCase();
---

{popup.enabled && (
  <div
    id="popup-announcement"
    class={`popup popup--${variant}`}
    data-popup-id={popupId}
    data-dismissible={popup.dismissible ? 'true' : 'false'}
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="popup-title"
  >
    <div class="popup__backdrop" data-close></div>
    <div class="popup__card" tabindex="-1">
      <h2 id="popup-title" class="popup__title">Announcement</h2>
      <p class="popup__message">{popup.message}</p>
      <div class="popup__actions">
        {popup.link && (
          <a href={siteLink(popup.link)} class="popup__cta">
            {popup.linkText ?? 'Details'}
          </a>
        )}
        {popup.dismissible && (
          <button type="button" class="popup__dismiss" data-close>
            Dismiss
          </button>
        )}
      </div>
    </div>
  </div>
)}

<script>
  const el = document.getElementById('popup-announcement');
  if (el) {
    const id = el.dataset.popupId ?? 'default';
    const key = `makenew-popup-${id}`;
    const dismissible = el.dataset.dismissible === 'true';
    const card = el.querySelector('.popup__card');

    // This is a true modal (role="dialog" aria-modal="true") — while open,
    // it must trap focus and hide the rest of the page from keyboard/screen
    // readers, not just visually cover it. `.top-bar`/`.header`/#app-shell
    // are this component's siblings in Site.astro, so they're addressed
    // directly rather than via a shared wrapper (no such wrapper exists).
    const backgroundRegions = [
      document.querySelector('.top-bar'),
      document.querySelector('.header'),
      document.getElementById('app-shell'),
    ].filter((node) => node instanceof HTMLElement);

    let lastFocused = null;

    function setBackgroundInert(inert) {
      backgroundRegions.forEach((node) => {
        if (inert) {
          node.setAttribute('aria-hidden', 'true');
          node.setAttribute('inert', '');
        } else {
          node.removeAttribute('aria-hidden');
          node.removeAttribute('inert');
        }
      });
    }

    function getFocusableInPopup() {
      return [...el.querySelectorAll('a[href], button:not([disabled])')];
    }

    function openPopup() {
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      el.removeAttribute('hidden');
      setBackgroundInert(true);
      const focusable = getFocusableInPopup();
      (focusable[0] ?? card ?? el).focus();
    }

    function closePopup(persist = true) {
      el.setAttribute('hidden', '');
      setBackgroundInert(false);
      lastFocused?.focus();
      lastFocused = null;
      if (dismissible && persist) localStorage.setItem(key, '1');
    }

    window.openMakenewPopup = openPopup;

    if (!dismissible || !localStorage.getItem(key)) {
      openPopup();
    }

    el.querySelectorAll('[data-close]').forEach((node) => {
      node.addEventListener('click', () => closePopup(true));
    });

    document.addEventListener('keydown', (e) => {
      if (el.hasAttribute('hidden')) return;

      // Matches the existing backdrop-click behavior, which already closes
      // the popup unconditionally (see .popup__backdrop's [data-close]) —
      // Escape stays consistent with that rather than introducing a new
      // dismissible-only exception.
      if (e.key === 'Escape') {
        closePopup(true);
        return;
      }

      if (e.key !== 'Tab') return;
      const focusable = getFocusableInPopup();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('openMakenewPopup', () => openPopup());
  }
</script>

<style>
  .popup {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  .popup[hidden] { display: none; }
  .popup__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }
  .popup__card {
    position: relative;
    width: min(100%, 24rem);
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
  }
  .popup--dark .popup__card {
    background: #111;
    color: #f1f1f1;
    border: 1px solid #333;
  }
  .popup--light .popup__card {
    background: #fff;
    color: #111827;
    border: 1px solid #e5e7eb;
  }
  .popup__title {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .popup__message {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .popup__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .popup__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    min-height: 44px;
  }
  .popup--dark .popup__cta {
    background: #9bff9b;
    color: #000;
  }
  .popup--light .popup__cta {
    background: #111827;
    color: #fff;
  }
  .popup__dismiss {
    padding: 0.625rem 1rem;
    border: 1px solid currentColor;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    min-height: 44px;
  }
</style>
