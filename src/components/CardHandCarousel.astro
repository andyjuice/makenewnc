---
/**
 * CardHandCarousel — iMessage-style photo stack for the home page.
 * Content from src/data/carousel.yaml; images in public/images/carousel/.
 * Optional per-card link shows an external-link control on the front card.
 */
import type { CarouselCard } from '../lib/content';

interface Props {
  cards: CarouselCard[];
}

const { cards } = Astro.props;
const deckJson = JSON.stringify({ cards });
---

<div
  class="photo-stack"
  data-photo-stack
  data-deck={deckJson}
  tabindex="0"
  role="region"
  aria-roledescription="carousel"
  aria-label="Recent photos"
>
  <div class="photo-stack__meta" data-photo-meta hidden>
    <svg class="photo-stack__grid-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
      <rect x="1" y="1" width="6" height="6" rx="1.5" fill="currentColor" />
      <rect x="9" y="1" width="6" height="6" rx="1.5" fill="currentColor" />
      <rect x="1" y="9" width="6" height="6" rx="1.5" fill="currentColor" />
      <rect x="9" y="9" width="6" height="6" rx="1.5" fill="currentColor" />
    </svg>
    <span class="photo-stack__meta-label" data-photo-count></span>
  </div>

  <div class="photo-stack__stage">
    <div class="photo-stack__pile" data-photo-pile></div>
  </div>

  <p class="photo-stack__hint" data-photo-hint hidden>
    <span class="photo-stack__hint-icon" aria-hidden="true">↔</span>
    Swipe to see more photos
  </p>
</div>

<script>
  /** @param {HTMLElement} root */
  function initPhotoStack(root) {
    const meta = root.querySelector('[data-photo-meta]');
    const countLabel = root.querySelector('[data-photo-count]');
    const hint = root.querySelector('[data-photo-hint]');
    const pile = root.querySelector('[data-photo-pile]');
    if (!pile) return;

    /** @type {{ imageUrl: string; alt: string; link?: string }[]} */
    let cards = [];
    let index = 0;
    let autoTimer = null;
    let paused = false;
    let animating = false;

    const PEEK = 14;
    const DEPTH = 4;
    const SWIPE = 52;
    const AUTO_MS = 12000;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function layerTransform(layer) {
      return `translate3d(${layer * PEEK}px, 0, 0)`;
    }

    function applyLayer(el, layer, { resetMotion = true } = {}) {
      el.style.transform = layerTransform(layer);
      el.style.zIndex = String(DEPTH - layer + 1);
      el.dataset.layer = String(layer);
      el.classList.toggle('is-front', layer === 0);
      if (resetMotion) {
        el.style.opacity = '1';
        el.style.transition = '';
      }
    }

    /** @type {Map<string, Promise<void>>} */
    const imageReady = new Map();

    function preloadImage(url) {
      if (imageReady.has(url)) return imageReady.get(url);
      const promise = new Promise((resolve) => {
        const probe = new Image();
        probe.onload = () => resolve();
        probe.onerror = () => resolve();
        probe.src = url;
      });
      imageReady.set(url, promise);
      return promise;
    }

    function preloadAllImages() {
      const urls = [...new Set(cards.map((c) => c.imageUrl))];
      const eager = urls.slice(0, DEPTH + 2);
      const rest = urls.slice(DEPTH + 2);
      return Promise.all(eager.map(preloadImage)).then(() => {
        const loadRest = () => Promise.all(rest.map(preloadImage));
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(() => { loadRest(); });
        } else {
          window.setTimeout(loadRest, 200);
        }
      });
    }

    function setCardLink(article, card, layer) {
      const existing = article.querySelector('.photo-stack__card-link');
      if (layer !== 0 || !card.link) {
        existing?.remove();
        return;
      }
      const link = existing instanceof HTMLAnchorElement
        ? existing
        : document.createElement('a');
      link.className = 'photo-stack__card-link';
      link.href = card.link;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.setAttribute('aria-label', `Open link: ${card.alt}`);
      if (!existing) {
        link.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <polyline points="15 3 21 3 21 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="10" y1="14" x2="21" y2="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>`;
        article.appendChild(link);
      }
    }

    /** @param {HTMLElement} article @param {{ imageUrl: string; alt: string; link?: string }} card @param {number} layer */
    function updateCard(article, card, layer) {
      article.className = 'photo-stack__card';
      applyLayer(article, layer);

      let img = article.querySelector('img');
      if (!(img instanceof HTMLImageElement)) {
        img = document.createElement('img');
        img.draggable = false;
        img.decoding = 'async';
        img.loading = 'eager';
        article.prepend(img);
      }

      img.alt = card.alt;
      if (img.dataset.imageUrl !== card.imageUrl) {
        img.dataset.imageUrl = card.imageUrl;
        img.src = card.imageUrl;
      }

      if (layer === 0) img.setAttribute('fetchpriority', 'high');
      else img.removeAttribute('fetchpriority');

      setCardLink(article, card, layer);
    }

    function updateMeta() {
      if (!meta || !countLabel) return;
      if (cards.length === 0) {
        meta.hidden = true;
        if (hint) hint.hidden = true;
        return;
      }
      meta.hidden = false;
      const n = cards.length;
      countLabel.textContent = n === 1 ? '1 Photo' : `${n} Photos`;
      root.setAttribute('aria-label', `Recent photos, ${(index % n) + 1} of ${n}`);
      if (hint) hint.hidden = n < 2;
    }

    function clearAuto() {
      if (autoTimer) {
        clearTimeout(autoTimer);
        autoTimer = null;
      }
    }

    function scheduleAuto() {
      clearAuto();
      if (reducedMotion || paused || animating || cards.length < 2) return;
      autoTimer = window.setTimeout(() => advance(1), AUTO_MS);
    }

    function render() {
      if (cards.length === 0) {
        pile.innerHTML = '<p class="photo-stack__empty">No photos yet.</p>';
        updateMeta();
        return;
      }

      const visible = Math.min(DEPTH + 1, cards.length);
      /** @type {HTMLElement[]} */
      let articles = [...pile.querySelectorAll('.photo-stack__card')];

      while (articles.length < visible) {
        const article = document.createElement('article');
        const img = document.createElement('img');
        img.draggable = false;
        img.decoding = 'async';
        img.loading = 'eager';
        article.appendChild(img);
        pile.appendChild(article);
        articles.push(article);
      }
      while (articles.length > visible) {
        articles.pop()?.remove();
        articles = [...pile.querySelectorAll('.photo-stack__card')];
      }

      for (let layer = visible - 1; layer >= 0; layer--) {
        const ci = (index + layer) % cards.length;
        const article = articles[visible - 1 - layer];
        updateCard(article, cards[ci], layer);
      }

      updateMeta();
      bindDrag();
      scheduleAuto();
    }

    /** After swipe animation — rotate DOM so the revealed card stays front; sync all layers. */
    function completeAdvance(delta) {
      index = (index + delta + cards.length) % cards.length;
      animating = false;

      const visible = Math.min(DEPTH + 1, cards.length);
      const articles = [...pile.querySelectorAll('.photo-stack__card')];

      if (delta > 0) {
        const exited = articles.pop();
        if (exited) pile.insertBefore(exited, pile.firstChild);
      } else {
        const exited = articles.shift();
        if (exited) pile.appendChild(exited);
      }

      const rotated = [...pile.querySelectorAll('.photo-stack__card')];
      for (let layer = 0; layer < visible; layer++) {
        const article = rotated[visible - 1 - layer];
        const ci = (index + layer) % cards.length;
        updateCard(article, cards[ci], layer);
      }

      updateMeta();
      bindDrag();
      scheduleAuto();
    }

    let dragState = null;

    function bindDrag() {
      const front = pile.querySelector('.is-front');
      if (!front || cards.length < 2) return;

      front.onpointerdown = (e) => {
        if (e.button !== 0) return;
        paused = true;
        clearAuto();
        dragState = { startX: e.clientX, el: front, active: false, pointerId: e.pointerId };
        front.setPointerCapture(e.pointerId);
      };

      front.onpointermove = (e) => {
        if (!dragState || dragState.el !== front) return;
        const dx = e.clientX - dragState.startX;
        if (!dragState.active && Math.abs(dx) > 6) dragState.active = true;
        if (!dragState.active) return;
        front.style.transition = 'none';
        front.style.transform = `translate3d(${dx}px, 0, 0)`;
      };

      const endDrag = (e) => {
        if (!dragState || dragState.el !== front) return;
        try { front.releasePointerCapture(dragState.pointerId); } catch { /* ok */ }
        const dx = e.clientX - dragState.startX;
        dragState = null;
        if (Math.abs(dx) >= SWIPE) {
          advance(dx < 0 ? 1 : -1);
          return;
        }
        front.style.transition = 'transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        applyLayer(front, 0);
        if (!root.matches(':hover') && !root.contains(document.activeElement)) {
          paused = false;
          scheduleAuto();
        }
      };

      front.onpointerup = endDrag;
      front.onpointercancel = endDrag;
    }

    function advance(delta) {
      if (cards.length === 0 || animating) return;
      const front = pile.querySelector('.is-front');
      if (!front) {
        index = (index + delta + cards.length) % cards.length;
        render();
        return;
      }

      animating = true;
      clearAuto();

      const exitX = delta > 0 ? -140 : 140;
      front.style.transition = 'transform 0.34s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.34s ease';
      front.style.transform = `translate3d(${exitX}px, 0, 0)`;
      front.style.opacity = '0';

      pile.querySelectorAll('[data-layer]').forEach((el) => {
        const layer = Number(el.dataset.layer);
        if (layer === 0) return;
        const next = layer - 1;
        el.style.transition = 'transform 0.34s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        applyLayer(el, next, { resetMotion: false });
      });

      window.setTimeout(() => {
        completeAdvance(delta);
      }, 340);
    }

    root.addEventListener('mouseenter', () => { paused = true; clearAuto(); });
    root.addEventListener('mouseleave', () => { paused = false; scheduleAuto(); });
    root.addEventListener('focusin', () => { paused = true; clearAuto(); });
    root.addEventListener('focusout', () => {
      window.setTimeout(() => {
        if (!root.contains(document.activeElement)) {
          paused = false;
          scheduleAuto();
        }
      }, 0);
    });

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); advance(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); advance(1); }
    });

    const deck = JSON.parse(root.dataset.deck || '{}');
    cards = deck.cards || [];
    render();
    preloadAllImages();
  }

  document.querySelectorAll('[data-photo-stack]').forEach((root) => {
    if (root instanceof HTMLElement) initPhotoStack(root);
  });
</script>

<style>
  .photo-stack {
    --peek: 14px;
    --depth: 4;
    --card-max: 320px;
    width: 100%;
    max-width: var(--card-max);
    margin: 0 auto;
    outline: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .photo-stack:focus-visible {
    outline: 2px solid var(--accent, #007aff);
    outline-offset: 4px;
    border-radius: 18px;
  }

  .photo-stack__meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.45rem;
    padding-left: 0.125rem;
  }
  .photo-stack__grid-icon { color: #007aff; flex-shrink: 0; }
  :global(.site--dark) .photo-stack__grid-icon { color: #64b5ff; }
  .photo-stack__meta-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #007aff;
    letter-spacing: -0.01em;
  }
  :global(.site--dark) .photo-stack__meta-label { color: #64b5ff; }

  .photo-stack__stage {
    padding-right: calc(var(--peek) * var(--depth));
  }

  .photo-stack__pile {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    isolation: isolate;
  }

  :global(.photo-stack__card) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 20px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
    transform: translate3d(0, 0, 0);
    transition: transform 0.34s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                opacity 0.34s ease;
    cursor: grab;
    touch-action: pan-y;
  }
  :global(.photo-stack__card:active) { cursor: grabbing; }
  :global(.photo-stack__card.is-front) {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.22);
    z-index: 5;
  }
  :global(.site--dark .photo-stack__card) {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }
  :global(.site--dark .photo-stack__card.is-front) {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.65);
  }

  :global(.photo-stack__card img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  :global(.photo-stack__card-link) {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.2s ease, background 0.2s ease;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  @media (hover: hover) {
    :global(.photo-stack__card.is-front:hover .photo-stack__card-link) {
      opacity: 1;
    }
  }
  @media (hover: none) {
    :global(.photo-stack__card-link) { opacity: 0.85; }
  }
  :global(.photo-stack__card-link:focus-visible) {
    opacity: 1;
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  :global(.photo-stack__empty) {
    margin: 0;
    color: var(--muted, #8e8e93);
    font-size: 0.875rem;
    text-align: center;
    padding: 3rem 0;
  }

  .photo-stack__hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin: 0.875rem 0 0;
    padding-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--muted, #8e8e93);
    text-align: center;
    letter-spacing: 0.01em;
  }
  .photo-stack__hint-icon {
    font-size: 0.875rem;
    opacity: 0.7;
  }
</style>
