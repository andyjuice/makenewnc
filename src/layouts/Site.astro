---
/**
 * Site layout — Instagram Gateway production design for makenewnc.org.
 * Dark/light mode via header toggle (localStorage makenew-theme); push drawer nav below header.
 */
import TopBarAnnouncement from '../components/TopBarAnnouncement.astro';
import PopupAnnouncement from '../components/PopupAnnouncement.astro';
import CampusInstagramMenu from '../components/CampusInstagramMenu.astro';
import { getSite, getAnnouncements, getCampuses } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  scrollable?: boolean;
  home?: boolean;
}

const {
  title,
  description,
  scrollable = false,
  home = false,
} = Astro.props;

const site = getSite();
const announcements = getAnnouncements();
const campuses = getCampuses();

// Drawer nav links + current-page detection, so keyboard/screen-reader users
// get an aria-current landmark instead of only a visual/hover cue.
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/locations', label: 'Locations' },
  { href: '/what-were-about', label: "What we're about" },
  { href: '/our-story', label: 'Our Story' },
  { href: '/our-beliefs', label: 'Our Beliefs' },
  { href: '/christian-themes-for-privileged-teens', label: 'CTPT' },
  { href: '/privacy', label: 'Privacy' },
];
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
function isCurrentNavLink(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? site.tagline} />
    <title>{title} · {site.name}</title>
    <!--
      Favicon/touch-icon set generated (scripts/generate-favicons.py) from
      the [make]new bars mark (public/images/makenew-icon.png). Two
      variants: favicon.ico/-16x16/-32x32 are black bars on a truly
      transparent background (renders correctly in modern browser tabs,
      light or dark chrome). apple-touch-icon/icon-192/icon-512 stay black
      bars on opaque white instead, because iOS fills transparent
      home-screen icons with solid black. See
      decisions/2026-08-02-favicon-set.md for the full history.
      favicon.ico covers legacy browsers; PNG variants cover modern browsers,
      iOS home-screen, and Android/PWA install prompts.
    -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />
    <script is:inline>
      try {
        var theme = localStorage.getItem('makenew-theme') || 'dark';
        if (theme === 'dark') {
          document.documentElement.classList.add('site-theme-dark');
          document.documentElement.style.background = '#0a0a0a';
        }
      } catch (e) {}
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class:list={['site', 'site--dark', { 'site--home': home }]}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <script is:inline>
      try {
        if ((localStorage.getItem('makenew-theme') || 'dark') === 'light') {
          document.body.classList.remove('site--dark');
          var topBar = document.querySelector('.top-bar');
          if (topBar) {
            topBar.classList.remove('top-bar--dark');
            topBar.classList.add('top-bar--mint');
          }
        }
      } catch (e) {}
    </script>
    <TopBarAnnouncement announcements={announcements} variant="dark" />
    <header class="header">
      <a href="/" class="header__brand" aria-label="[make]new home">
        <img src="/images/makenew-icon.png" alt="" class="header__logo" width="80" height="28" />
      </a>
      <div class="header__tools">
        <button
          type="button"
          class="header__icon-btn"
          id="theme-toggle"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <svg class="header__icon header__icon--sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg class="header__icon header__icon--moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <button
          class="header__icon-btn"
          type="button"
          aria-expanded="false"
          aria-controls="site-drawer"
          id="menu-toggle"
          aria-label="Open menu"
        >
          <svg class="header__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
        </button>
      </div>
    </header>
    <div class="shell" id="app-shell">
      <nav id="site-drawer" class="drawer" hidden aria-hidden="true" aria-label="Site menu">
        {navLinks.map((link) => (
          <a href={link.href} aria-current={isCurrentNavLink(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
      <div class="shell__stage" id="app-stage">
        <main id="main-content" class:list={['main', { 'main--scroll': scrollable }]}><slot /></main>
        <aside class="social-bar" aria-label="Social media">
          <CampusInstagramMenu campuses={campuses} variant="footer" instanceId="footer" />
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer">
            Facebook<span class="visually-hidden"> (opens in new tab)</span>
          </a>
          <a href={site.social.youtube} target="_blank" rel="noopener noreferrer">
            YouTube<span class="visually-hidden"> (opens in new tab)</span>
          </a>
        </aside>
      </div>
    </div>
    <PopupAnnouncement announcements={announcements} variant="dark" />
    <script>
      const THEME_KEY = 'makenew-theme';

      function applyTheme(theme) {
        const isDark = theme === 'dark';
        document.documentElement.classList.toggle('site-theme-dark', isDark);
        document.documentElement.style.background = isDark ? '#0a0a0a' : '';
        document.body.classList.toggle('site--dark', isDark);

        const sun = document.querySelector('.header__icon--sun');
        const moon = document.querySelector('.header__icon--moon');
        sun?.toggleAttribute('hidden', isDark);
        moon?.toggleAttribute('hidden', !isDark);

        const popup = document.getElementById('popup-announcement');
        if (popup) {
          popup.classList.remove('popup--light', 'popup--dark');
          popup.classList.add(isDark ? 'popup--dark' : 'popup--light');
        }
        const topBar = document.querySelector('.top-bar');
        if (topBar) {
          topBar.classList.remove('top-bar--mint', 'top-bar--dark');
          topBar.classList.add(isDark ? 'top-bar--dark' : 'top-bar--mint');
        }
      }

      const savedTheme = localStorage.getItem(THEME_KEY) || 'dark';
      applyTheme(savedTheme);

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.body.classList.contains('site--dark') ? 'light' : 'dark';
        localStorage.setItem(THEME_KEY, next);
        applyTheme(next);
      });

      const btn = document.getElementById('menu-toggle');
      const drawer = document.getElementById('site-drawer');
      const shell = document.getElementById('app-shell');
      const appStage = document.getElementById('app-stage');

      // Drawer nav focus management: while open, the drawer is the only
      // interactive region a keyboard/screen-reader user should reach —
      // background content (appStage) is still partially visible (the push
      // transform reveals it at the left edge on narrow viewports) but isn't
      // meant to be operable. Mirrors the tab-trap pattern already used by
      // CampusInstagramMenu's mobile sheet.
      let lastFocusedBeforeDrawer = null;

      function getFocusableDrawerLinks() {
        return drawer ? [...drawer.querySelectorAll('a[href]')] : [];
      }

      function setDrawerOpen(open) {
        if (!drawer || !shell || !btn || !appStage) return;

        if (open) {
          lastFocusedBeforeDrawer = document.activeElement instanceof HTMLElement ? document.activeElement : null;
          drawer.removeAttribute('hidden');
          drawer.setAttribute('aria-hidden', 'false');
          btn.setAttribute('aria-expanded', 'true');
          appStage.setAttribute('aria-hidden', 'true');
          appStage.setAttribute('inert', '');
          requestAnimationFrame(() => {
            shell.classList.add('shell--drawer-open');
            drawer.classList.add('drawer--open');
          });
          getFocusableDrawerLinks()[0]?.focus();
          return;
        }

        shell.classList.remove('shell--drawer-open');
        drawer.classList.remove('drawer--open');
        drawer.setAttribute('aria-hidden', 'true');
        // Also inert immediately (not just aria-hidden): the drawer stays
        // in the DOM without the `hidden` attribute until the slide-out
        // transition finishes below, so without this, a fast Tab press
        // right after closing could still focus a now off-screen,
        // aria-hidden link during that window.
        drawer.setAttribute('inert', '');
        btn.setAttribute('aria-expanded', 'false');
        appStage.removeAttribute('aria-hidden');
        appStage.removeAttribute('inert');
        (lastFocusedBeforeDrawer ?? btn).focus();
        lastFocusedBeforeDrawer = null;
        window.setTimeout(() => {
          drawer.setAttribute('hidden', '');
          drawer.removeAttribute('inert');
        }, 280);
      }

      btn?.addEventListener('click', () => {
        setDrawerOpen(!shell.classList.contains('shell--drawer-open'));
      });

      drawer?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setDrawerOpen(false));
      });

      document.addEventListener('keydown', (e) => {
        if (!shell.classList.contains('shell--drawer-open')) return;

        if (e.key === 'Escape') {
          setDrawerOpen(false);
          return;
        }

        if (e.key !== 'Tab') return;
        const focusable = getFocusableDrawerLinks();
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        const active = document.activeElement;

        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Respect the OS-level reduced-motion preference for every transition/
     animation site-wide (auto-advancing carousels/taglines already gate
     themselves in JS — see GatewayTagline.astro / CardHandCarousel.astro;
     this catches the rest: drawer slide, popups, hover/focus transitions). */
  @media (prefers-reduced-motion: reduce) {
    .site,
    .site *,
    .site *::before,
    .site *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Visually hidden but screen-reader-accessible — e.g. announcing that a
     link opens in a new tab, without adding visible clutter. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Skip link — hidden until keyboard-focused, then pinned to the top so
     keyboard/screen-reader users can bypass the announcement bar + header
     and land directly on page content. */
  .skip-link {
    position: absolute;
    top: -3rem;
    left: 1rem;
    z-index: 200;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    background: var(--accent, #e1306c);
    color: #0a0a0a;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    text-decoration: none;
    transition: top 0.15s ease;
  }
  .skip-link:focus-visible {
    top: 1rem;
    outline: 2px solid var(--text, #0f172a);
    outline-offset: 2px;
  }

  .site {
    --bg: #fff;
    --text: #0f172a;
    --muted: #64748b;
    --accent: #e1306c;
    --border: #e2e8f0;
    --phone-screen: #f8fafc;
    --font: 'Space Grotesk', system-ui, sans-serif;
    /* Fixed length so calc()/right offsets resolve reliably in WebKit
       (min()/vw inside var() broke drawer positioning on iOS Safari). */
    --drawer-w: 17.5rem;
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    line-height: 1.5;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  .site--dark {
    --bg: #0a0a0a;
    --text: #f1f5f9;
    --muted: #94a3b8;
    --accent: #9bff9b;
    --border: #333;
    --phone-screen: #1e293b;
  }
  .site * { box-sizing: border-box; }
  .site .header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.75rem 1rem; border-bottom: 1px solid var(--border);
  }
  .site .header__brand {
    display: flex; align-items: center; text-decoration: none;
    min-height: 44px;
  }
  .site .header__logo {
    height: 22px;
    width: auto;
    display: block;
  }
  /* PNG is white bars on black; invert only on light header so matte matches bg */
  .site:not(.site--dark) .header__logo {
    filter: invert(1);
  }
  .site .header__tools {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .site .header__icon-btn {
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .site .header__icon { display: block; }
  .site .header__icon[hidden] { display: none; }

  /* Push drawer — lives below header; shifts page content left.
     Drawer motion uses the `right` offset, not transform percentages:
     iOS Safari mis-resolves translateX(100%) on right-anchored panels and
     can park the open drawer off the left edge (only divider slivers visible).
     Keep the open drawer above the sliding stage for WebKit compositing. */
  .site .shell {
    position: relative;
    flex: 1;
    overflow: hidden;
    min-height: 0;
    isolation: isolate;
  }
  .site .shell__stage {
    position: relative;
    z-index: 2;
    min-height: 100%;
    background: var(--bg);
    transition: transform 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    padding-bottom: 0;
    display: flex;
    flex-direction: column;
  }
  .site .shell--drawer-open .shell__stage {
    transform: translate3d(calc(-1 * var(--drawer-w)), 0, 0);
  }

  .site .drawer {
    position: absolute;
    top: 0;
    right: calc(-1 * var(--drawer-w));
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: var(--drawer-w);
    height: 100%;
    margin: 0;
    padding: 1.25rem;
    padding-right: max(1.25rem, env(safe-area-inset-right));
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    border-left: 1px solid var(--border);
    background: var(--bg);
    overflow-y: auto;
    transition: right 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .site .drawer.drawer--open,
  .site .shell--drawer-open .drawer {
    right: 0;
    z-index: 3;
  }
  .site--dark .drawer { background: #111; }
  .site .drawer[hidden] { display: none; }
  .site .drawer a {
    padding: 0.875rem 0;
    text-decoration: none;
    color: #0f172a;
    -webkit-text-fill-color: currentColor;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-weight: 700;
    font-size: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .site--dark .drawer a { color: #f1f5f9; }
  .site .drawer a:last-child { border-bottom: none; }
  .site .drawer a:hover { color: var(--accent); }
  .site .drawer a[aria-current="page"] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .site .main {
    padding: 1.25rem 1rem 2rem;
    max-width: 28rem;
    margin: 0 auto;
    min-height: calc(100dvh - 8rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    flex: 1;
  }
  .site--home .main {
    max-width: min(56rem, 100%);
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
  }
  .site .main--scroll { justify-content: flex-start; }
  .site .gateway {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }
  @media (min-width: 640px) {
    .site--home .gateway {
      display: grid;
      grid-template-columns: 1fr min(44%, 360px);
      grid-template-rows: auto auto;
      gap: 1rem 2.5rem;
      align-items: center;
    }
    .site--home .gateway__hero {
      grid-column: 1;
      grid-row: 1;
      align-self: end;
    }
    .site--home .gateway__media {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
      overflow: visible;
      padding-right: 0.5rem;
    }
    .site--home .gateway__actions {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }
  }
  .site .gateway__address {
    display: block; margin-bottom: 0.75rem; color: var(--muted);
    text-decoration: none; font-size: 0.9375rem; min-height: 44px;
  }
  .site .gateway__ig {
    display: flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 0.875rem 1rem;
    /* Solid --accent fill, not the Instagram-brand gradient: the gradient
       (darkened in the 2026-08-02 accessibility audit to clear contrast —
       see decisions/2026-08-02-accessibility-audit.md, "Amendment: solid
       accent color") was replaced outright per a later design request to
       match the site's own accent color instead of an Instagram-brand
       treatment. #0a0a0a text on --accent (#e1306c) is 4.56:1, clearing the
       4.5:1 WCAG AA minimum for normal-size text — verified via the WCAG
       relative-luminance formula, not eyeballed. Same accent+dark-text
       pairing already used by .skip-link and .fart-item__letter. */
    background: var(--accent);
    color: #0a0a0a; font-weight: 700; font-size: 1rem;
    border-radius: 12px; text-decoration: none; margin-bottom: 0.75rem;
    width: 100%;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .site--dark .gateway__ig {
    border: 2px solid var(--accent);
    background: transparent;
    color: var(--accent);
  }
  .site .gateway__ig.campus-ig-btn { margin-top: 1.5rem; }
  .site .gateway__ig.campus-ig-btn[data-campus="duke"] {
    background: #003087; color: #fff; border: none;
  }
  .site .gateway__ig.campus-ig-btn[data-campus="nc-state"] {
    background: #cc0000; color: #fff; border: none;
  }
  .site .gateway__ig.campus-ig-btn[data-campus="unc"] {
    background: #7bafd4; color: #0f172a; border: none;
  }
  .site--dark .gateway__ig.campus-ig-btn[data-campus="duke"] {
    background: transparent; border: 2px solid #5b8fd9; color: #5b8fd9;
  }
  .site--dark .gateway__ig.campus-ig-btn[data-campus="nc-state"] {
    background: transparent; border: 2px solid #cc0000; color: #cc0000;
  }
  .site--dark .gateway__ig.campus-ig-btn[data-campus="unc"] {
    background: transparent; border: 2px solid #7bafd4; color: #7bafd4;
  }
  .site .campus-ig-menu {
    position: relative;
    width: 100%;
  }
  .site .campus-ig-menu--footer {
    width: auto;
  }
  .site .campus-ig-menu__trigger--footer {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: none;
    background: transparent;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    text-decoration: none;
  }
  .site .campus-ig-menu--footer .campus-ig-menu__panel {
    left: 50%;
    right: auto;
    top: auto;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
    min-width: min(16rem, 80vw);
  }
  .site .campus-ig-menu__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 30;
    padding: 0.75rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--phone-screen, #fff);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.14);
  }
  .site--dark .campus-ig-menu__panel {
    background: #111;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  }
  .site .campus-ig-menu__panel[hidden] { display: none; }
  .site .campus-ig-menu__label {
    margin: 0 0 0.5rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .site .campus-ig-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .site .campus-ig-menu__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    /* Explicit theme text — footer panel lives inside .social-bar, whose
       direct-link color (#e2e8f0) is for the dark bar only and must not
       cascade onto this light popup surface (WCAG contrast failure). */
    color: var(--text);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .site .campus-ig-menu__name { font-weight: 700; color: var(--text); }
  .site .campus-ig-menu__city { font-size: 0.8125rem; color: var(--muted); }
  .site .campus-ig-menu__option[data-campus="duke"]:hover {
    border-color: #003087;
    background: rgba(0, 48, 135, 0.1);
  }
  .site .campus-ig-menu__option[data-campus="nc-state"]:hover {
    border-color: #cc0000;
    background: rgba(204, 0, 0, 0.08);
  }
  .site .campus-ig-menu__option[data-campus="unc"]:hover {
    border-color: #7bafd4;
    background: rgba(123, 175, 212, 0.12);
