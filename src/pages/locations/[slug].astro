---
/**
 * Campus detail — service times, address, gallery carousel, and contact per location.
 */
import Site from '../../layouts/Site.astro';
import CardHandCarousel from '../../components/CardHandCarousel.astro';
import { getCampuses, getCampusCarouselCards, getSite, siteLink } from '../../lib/content';
import {
  buildCampusEventJsonLd,
  buildCampusPlaceJsonLd,
  campusMetaDescription,
} from '../../lib/seo';

export function getStaticPaths() {
  return getCampuses().map((campus) => ({
    params: { slug: campus.slug },
    props: { campus },
  }));
}

const { campus } = Astro.props;
const site = getSite();
const carouselCards = getCampusCarouselCards(campus.slug);
const friday = campus.services?.friday;
const sunday = campus.services?.sunday;
const campusJsonLd = [
  buildCampusPlaceJsonLd(campus, site),
  ...buildCampusEventJsonLd(campus, site),
];
---

<Site
  title={`${campus.name} · Locations`}
  description={campusMetaDescription(campus)}
  jsonLd={campusJsonLd}
  scrollable
>
  <a href={siteLink('/locations')} class="back-link">← All locations</a>

  <h1 class="page-title">{campus.name}</h1>

  {carouselCards.length > 0 && (
    <section class="campus-gallery" aria-label={`${campus.name} photo gallery`}>
      <h2 class="section-label">Gallery</h2>
      <CardHandCarousel cards={carouselCards} />
    </section>
  )}

  <p class="page-lead">{campus.description}</p>

  {campus.address && (
    <a
      href={campus.address.mapsUrl}
      class="gateway__address"
      target="_blank"
      rel="noopener noreferrer"
    >
      {campus.address.street}, {campus.address.city} {campus.address.state}
      {campus.address.note && ` · ${campus.address.note}`}
      <span class="visually-hidden"> (opens in new tab)</span>
    </a>
  )}

  {campus.contact && (
    <div class="campus-contact">
      <h2 class="section-label">Contact</h2>
      <p class="campus-contact__details">
        <a href={`tel:${campus.contact.phone.replace(/[^\d+]/g, '')}`} class="campus-contact__link">
          {campus.contact.phone}
        </a>
        <span class="campus-contact__sep" aria-hidden="true"> · </span>
        <a href={`mailto:${campus.contact.email}`} class="campus-contact__link">
          {campus.contact.email}
        </a>
      </p>
    </div>
  )}

  {friday && sunday && (
    <div class="service-blocks">
      <div class="gateway__gathering">
        <p class="gateway__gathering-label">Friday</p>
        <h2 class="gateway__gathering-title">{friday.name}</h2>
        <p class="gateway__gathering-time">{friday.time}</p>
        <p class="service-detail">Topic: {friday.topic}</p>
        <p class="service-detail">{friday.description}</p>
        <p class="service-detail">{friday.logistics}</p>
      </div>
      <div class="gateway__gathering">
        <p class="gateway__gathering-label">Sunday</p>
        <h2 class="gateway__gathering-title">
          {sunday.name}{sunday.subtitle && ` ${sunday.subtitle}`}
        </h2>
        <p class="gateway__gathering-time">{sunday.time}</p>
        <p class="service-detail">Topic: {sunday.topic}</p>
        <p class="service-detail">{sunday.description}</p>
        <p class="service-detail">{sunday.logistics}</p>
      </div>
    </div>
  )}

  <p class="instagram-updates-note">{site.instagramUpdatesNote}</p>

  <a
    href={campus.instagram}
    class="gateway__ig campus-ig-btn"
    data-campus={campus.slug}
    target="_blank"
    rel="noopener noreferrer"
  >
    Follow us on Instagram<span class="visually-hidden"> (opens in new tab)</span>
  </a>
</Site>
