---
import Site from '../layouts/Site.astro';
import { getBeliefs } from '../lib/content';

const beliefs = getBeliefs();
---

<Site title={beliefs.title} description={beliefs.seoDescription ?? beliefs.summary} scrollable>
  <h1 class="page-title">{beliefs.title}</h1>
  <p style="font-size:0.9375rem">{beliefs.summary}</p>
  {beliefs.body.split('\n\n').map((para) => <p style="font-size:0.9375rem">{para}</p>)}
</Site>
