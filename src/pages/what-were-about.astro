---
/**
 * What we're about — casual practical-values page from home.md pillars.
 * Includes the FART differentiator (Faith, Art, Reason, Technology).
 *
 * Structure (see specs/what-were-about.md for the full rationale):
 *   1. Title + subheader (subheader alone carries the "who we are" framing —
 *      there is deliberately no separate "Who we are" section anymore).
 *   2. FART — "Come FART with us": context copy, then four cards.
 *   3. Our values — the remaining pillars from home.md that FART doesn't
 *      already cover (Mobility, Living life together, Sharing the Gospel).
 *   4. Always on — Instagram pitch.
 */
import Site from '../layouts/Site.astro';
import { getHome, getSite } from '../lib/content';

const home = getHome();
const site = getSite();
const diff = home.differentiator;

// diff.intro is authored as one or more blank-line-separated paragraphs in
// content/home.md; split here so each renders as its own <p> instead of one
// run-on block.
const introParagraphs = diff.intro
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

// Screen readers get the full word list ("Faith, Art, Reason, Technology")
// instead of spelling out the letters, which is clearer than the acronym.
const acronymLabel = diff.items.map((item) => item.word).join(', ');
---

<Site title={home.aboutTitle} scrollable>
  <h1 class="page-title">{home.aboutTitle}</h1>
  <p class="page-lead" id="intro">{home.aboutIntro}</p>

  <section id="fart" class="about-section">
    <p class="section-label">{diff.title}</p>
    <p class="fart-acronym" aria-label={acronymLabel}>{diff.acronym}</p>
    {introParagraphs.map((paragraph) => (
      <p class="about-body">{paragraph}</p>
    ))}
    <dl class="fart-list">
      {diff.items.map((item) => (
        <div class="fart-item" id={`fart-${item.word.toLowerCase()}`}>
          <dt class="fart-item__term">
            <span class="fart-item__letter" aria-hidden="true">{item.letter}</span>
            {item.word}
          </dt>
          <dd class="fart-item__def">
            <p class="about-summary">{item.summary}</p>
            {/* item.body is trusted content-authored HTML (links, <abbr> tooltips) — see DifferentiatorItem in lib/content.ts */}
            <p class="fart-item__body" set:html={item.body} />
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="values" class="about-section">
    <p class="section-label">Our values</p>
    <p class="about-summary">The practical values that shape how we live together.</p>
  </section>

  {home.pillars.map((pillar) => (
    <section id={pillar.slug} class="about-section">
      <p class="section-label">{pillar.title}</p>
      <p class="about-summary">{pillar.summary}</p>
      <p>{pillar.body}</p>
    </section>
  ))}

  <section id="always-on" class="about-section">
    <p class="section-label">Always on</p>
    <p>{site.instagramPitch}</p>
  </section>
</Site>

<style>
  .fart-acronym {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 6vw, 2.25rem);
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .about-body {
    margin: 0 0 0.75rem;
    color: var(--muted);
  }
  .about-body:last-of-type {
    margin-bottom: 1.5rem;
  }
  .fart-list {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .fart-item {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .fart-item__term {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
  }
  .fart-item__letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 6px;
    background: var(--accent);
    color: #0a0a0a;
    font-size: 0.875rem;
    font-weight: 800;
  }
  :global(.site--dark) .fart-item__letter {
    background: var(--accent);
    color: #0a0a0a;
  }
  .fart-item__def {
    margin: 0;
  }
  /* Typography hierarchy: letter (above) > summary (.about-summary, bold) >
     body (below, subdued + smaller) — the extended description is
     supporting detail, not a second headline. */
  .fart-item__body {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--muted);
  }
  .fart-item__body :global(abbr) {
    text-decoration: underline dotted;
    text-decoration-color: var(--muted);
    cursor: help;
  }
  .fart-item__body :global(a) {
    color: var(--text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
