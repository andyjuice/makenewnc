---
import Site from '../layouts/Site.astro';
import { getPrivacy, getPrivacyBody } from '../lib/content';

const privacy = getPrivacy();
const body = getPrivacyBody();
---

<Site
  title={privacy.title}
  description={privacy.seoDescription}
  scrollable
>
  <h1 class="page-title">{privacy.title}</h1>
  {body.split('\n\n').map((p) => <p>{p}</p>)}
  <p><a href="/" class="back-link">← Back to [make]new</a></p>
</Site>
